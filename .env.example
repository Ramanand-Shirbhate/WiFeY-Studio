# ==============================================================================
# WiFeY Studio - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your credentials.
# Never commit your actual '.env' file to public version control!

# --- NGROK TUNNEL CONFIGURATION ---
# Your static Ngrok domain (e.g., your-domain.ngrok-free.dev)
NGROK_STATIC_DOMAIN=your-custom-domain.ngrok-free.dev
# Optional: Ngrok Authtoken for persistent tunnels
NGROK_AUTHTOKEN=

# --- CLOUDFLARE R2 BINARY STORAGE CONFIGURATION ---
# S3-compatible credentials from Cloudflare Dashboard -> R2 -> Manage API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_BUCKET=wifey-firmware
